generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  name                String
  email               String             @unique
  password            String
  createdAt           DateTime           @default(now())
  id                  Int                @id @default(autoincrement())
  avatar              String?
  updatedAt           DateTime           @updatedAt
  refreshToken        String?
  deletedAt           DateTime?
  isDeleted           Boolean            @default(false)
  activityLogs        ActivityLog[]
  comments            Comment[]
  sentInvitations     Invitation[]       @relation("InvitationSender")
  receivedInvitations Invitation[]       @relation("InvitationReceiver")
  createdProjects     Project[]
  projectMembers      ProjectMember[]
  assignedTasks       Task[]             @relation("TaskAssignee")
  userNotifications   UserNotification[]
  memberships         WorkspaceMember[]
}

model Workspace {
  name          String            @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  id            Int               @id @default(autoincrement())
  logo          String?
  deletedAt     DateTime?
  isDeleted     Boolean           @default(false)
  activityLogs  ActivityLog[]
  invitations   Invitation[]
  notifications Notification[]
  projects      Project[]
  tasks         Task[]
  members       WorkspaceMember[]
}

model WorkspaceMember {
  workspaceId Int
  userId      Int
  role        Role
  joinedAt    DateTime  @default(now())
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model Invitation {
  id          Int              @id @default(autoincrement())
  workspaceId Int
  email       String
  role        Role
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  invitedById Int
  invitedToId Int?
  token       String           @unique
  invitedBy   User             @relation("InvitationSender", fields: [invitedById], references: [id])
  invitedTo   User?            @relation("InvitationReceiver", fields: [invitedToId], references: [id])
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
}

model Project {
  id          Int             @id @default(autoincrement())
  workspaceId Int
  name        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById Int
  deletedAt   DateTime?
  isDeleted   Boolean         @default(false)
  createdBy   User            @relation(fields: [createdById], references: [id])
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  members     ProjectMember[]
  tasks       Task[]
}

model ProjectMember {
  projectId  Int
  userId     Int
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
}

model Task {
  id          Int        @id @default(autoincrement())
  workspaceId Int
  projectId   Int
  assignedTo  Int?
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  isDeleted   Boolean    @default(false)
  comments    Comment[]
  assignee    User?      @relation("TaskAssignee", fields: [assignedTo], references: [id])
  project     Project    @relation(fields: [projectId], references: [id])
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
}

model Comment {
  id        Int       @id @default(autoincrement())
  taskId    Int
  authorId  Int
  content   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  isDeleted Boolean   @default(false)
  author    User      @relation(fields: [authorId], references: [id])
  task      Task      @relation(fields: [taskId], references: [id])
}

model ActivityLog {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  userId      Int
  action      String
  entityType  String
  entityId    Int
  createdAt   DateTime  @default(now())
  metadata    Json?
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Notification {
  id          Int                @id @default(autoincrement())
  workspaceId Int
  type        String
  message     String
  taskId      Int?
  createdAt   DateTime           @default(now())
  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  users       UserNotification[]
}

model UserNotification {
  userId         Int
  notificationId Int
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  isDeleted      Boolean      @default(false)
  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@id([userId, notificationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
